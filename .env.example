# Студия — конфигурация окружения (день 28: локальный RAG на Ollama).
# Скопируйте в .env и заполните. .env в git не коммитится.

# --- Локальная LLM и локальный RAG: Ollama (дни 26, 28) ---
# OpenAI-совместимый API Ollama. Запуск: ollama serve
# Используется и для генерации (chat/completions), и для локального
# эмбеддера RAG (embeddings) — весь пайплайн остаётся на машине.
OLLAMA_BASE_URL=http://localhost:11434/v1
# Ollama не проверяет ключ; значение нужно лишь потому, что клиент
# всегда шлёт заголовок Authorization: Bearer <ключ>.
OLLAMA_API_KEY=ollama
# (день 28) Модель локального эмбеддера RAG. Установка:
#   ollama pull nomic-embed-text:v1.5
# Выбирается в UI: БЗ → Эмбеддер → «Ollama nomic-embed-text:v1.5 (локально)».
OLLAMA_EMBED_MODEL=nomic-embed-text:v1.5
# CLI-ассистент дня 31 (dev_assistant.py) использует СВОЙ эмбеддер для
# ответов на вопросы по проекту: bge-m3. На nomic-embed-text любой раздел
# «похож» на любой вопрос (cosine топ-5 отличался на 0.01) — ассистент
# отвечал не по запросу. Установка: ollama pull bge-m3
DEV_ASSISTANT_EMBED_MODEL=bge-m3

# --- Удалённый провайдер: GPustack (дни 5–25; опционален с дня 28) ---
GPUSTACK_BASE_URL=https://gpustack.data.lmru.tech/v1
GPUSTACK_API_KEY=
GPUSTACK_KEY_DEEPSEEK=
GPUSTACK_KEY_GLM=
# Ключ API-эмбеддера (эмбеддер «api», qwen3-vl-embedding-8b) и реранкера
# (этап 2, qwen3-reranker-4b). Не нужны при локальном эмбеддере ollama.
GPUSTACK_KEY_EMBED=
GPUSTACK_KEY_RERANK=
# Внутренний GPustack отдаёт самоподписанный сертификат: 0 — не проверять TLS.
GPUSTACK_VERIFY_SSL=0

# --- Локальная LLM как приватный сетевой сервис (день 30) ---
# Шлюз OpenAI-совместимого API для устройств в локальной сети: ключи
# клиентов, rate limit (RPM/TPM), лимит контекста с LLM-компрессией и
# учёт. Ollama при этом остаётся на loopback — наружу смотрит только
# шлюз. Подробности: README, раздел «День 30».
#
# Ключ дефолтного клиента: создаётся при первом запуске, если клиентов
# ещё нет. Смените на свой. В gateway.json хранится только SHA-256.
GATEWAY_CLIENT_KEY=sk-local-change-me
# Имя дефолтного клиента (необязательно).
GATEWAY_CLIENT_NAME=default
# Порт и хост, которые шлюз показывает как адрес для подключения.
# Если не заданы, берётся фактический порт сервера и LAN-адрес машины.
# GATEWAY_PORT=8110
# GATEWAY_HOST=192.168.1.10
# ВНИМАНИЕ: TLS не используется — трафик и ключ идут открытым текстом.
# Сервис предназначен ТОЛЬКО для доверенной локальной сети; наружу не
# выставляйте.

# --- AI-ревью PR в CI (день 32) ---
# Модель для `cli.py pr-review run` и для GitHub Action
# (.github/workflows/ai-review.yml). Если LLM_MODEL задан, он важнее
# конфига Студии; если нет — используется модель из конфига (дни 28–36).
# LLM_MODEL — имя модели; у OpenAI-совместимых провайдеров с префиксом:
#   openai/gpt-4o-mini, openrouter/qwen/qwen3-8b, qwen3:8b (Ollama)
# LLM_BACKEND — auto | ollama | openai (auto: ollama для localhost)
# LLM_BASE_URL — без /chat/completions (по умолчанию OLLAMA_BASE_URL)
# LLM_API_KEY  — ключ модели (пусто — детерминированный отчёт)
# LLM_MODEL=qwen3:8b
# LLM_BACKEND=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# Потолок промпта ревью в символах (по умолчанию 26 000 ≈ 6–7 тыс.
# токенов — влезает в окно Ollama 8192). Для моделей с большим окном
# можно поднять, например 80 000.
# REVIEW_MAX_PROMPT_CHARS=26000
# GitHub (для локальной проверки публикации комментария и PR из форка).
# В Actions GITHUB_TOKEN и GITHUB_EVENT_PATH выставляет сам GitHub.
# GITHUB_TOKEN=
# GITHUB_API_URL=https://api.github.com
